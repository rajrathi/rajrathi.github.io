# Build output
# NOTE: `public/` is NOT ignored — under Astro that directory holds committed
# static assets (images, favicon, robots.txt), not build output. The old Gatsby
# config ignored it because Gatsby built into it.
dist/
.astro/

# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment
.env*
!.env.example

# Editors / OS
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
