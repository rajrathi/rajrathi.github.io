---
/**
 * About section. The prose is content/about.md, rendered as-is — edit that file
 * and this section follows. The skill chips come from content/skills.yaml.
 */
import { getEntry, render } from 'astro:content';
import { site } from '~/lib/site';
import { url } from '~/lib/url';
import { getSkills, getEducation } from '~/lib/content';
import SectionHeading from './SectionHeading.astro';

const entry = await getEntry('pages', 'about');
if (!entry) {
  throw new Error('content/about.md is missing — the About section needs it.');
}
const { Content } = await render(entry);

const [skills, education] = await Promise.all([getSkills(), getEducation()]);
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionHeading index="01" title="About" id="about-title" />

    <div class="about">
      <div class="about__prose prose" data-reveal>
        <Content />
      </div>

      <aside class="about__aside">
        {
          site.avatar && (
            <figure class="about__figure" data-reveal data-reveal-delay="80">
              <img
                src={url(site.avatar)}
                alt={site.avatarAlt}
                width="440"
                height="440"
                loading="lazy"
                decoding="async"
                class="about__photo"
              />
            </figure>
          )
        }

        {
          education.length > 0 && (
            <div class="about__block" data-reveal data-reveal-delay="140">
              <h3 class="about__block-title">Education</h3>
              <ul class="about__education">
                {education.map((item) => (
                  <li>
                    <p class="about__degree">{item.data.degree}</p>
                    <p class="about__institution">
                      {item.data.url ? (
                        <a href={item.data.url} rel="noopener" target="_blank">
                          {item.data.institution}
                        </a>
                      ) : (
                        item.data.institution
                      )}
                    </p>
                    <p class="about__dates">
                      {item.data.start} — {item.data.end}
                    </p>
                    {item.data.note && <p class="about__note">{item.data.note}</p>}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    {
      skills.length > 0 && (
        <div class="skills" data-reveal>
          <h3 class="skills__title">Toolkit</h3>
          <dl class="skills__grid">
            {skills.map((group) => (
              <div class="skills__group">
                <dt class="skills__label">{group.data.group}</dt>
                <dd class="skills__items">
                  <ul class="chip-list">
                    {group.data.items.map((item) => (
                      <li>
                        <span class="chip">{item}</span>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  .about__prose {
    max-width: var(--measure);
  }

  .about__aside {
    display: grid;
    gap: var(--space-l);
  }

  .about__figure {
    margin: 0;
    position: relative;
  }

  .about__photo {
    width: 100%;
    max-width: 17rem;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-l);
    /* A faint duotone so the photo sits inside the palette rather than beside it. */
    filter: saturate(0.85) contrast(1.05);
  }

  .about__figure::after {
    content: '';
    position: absolute;
    inset: 0;
    max-width: 17rem;
    border-radius: var(--radius-l);
    pointer-events: none;
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--accent) 14%, transparent),
      transparent 55%,
      color-mix(in srgb, var(--accent-2) 16%, transparent)
    );
    mix-blend-mode: overlay;
  }

  /* The duotone is a dark-theme device: over warm paper the magenta half of it
     tints the photo pink, which reads as a colour-managed screenshot rather
     than as a treatment. The photo goes untinted in light mode instead. */
  :global(:root[data-theme='light']) .about__figure::after {
    display: none;
  }

  .about__block-title,
  .skills__title {
    margin: 0 0 var(--space-s);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .about__education {
    display: grid;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
    padding-left: var(--space-m);
  }

  .about__education p {
    margin: 0;
  }

  .about__degree {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--text);
  }

  .about__institution {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .about__institution a {
    color: inherit;
    text-decoration-color: var(--border-strong);
  }

  .about__institution a:hover {
    color: var(--accent);
  }

  .about__dates {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-3);
  }

  .about__note {
    margin-top: var(--space-2xs) !important;
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  /* -- Toolkit ------------------------------------------------------------- */
  .skills {
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--border);
  }

  .skills__grid {
    display: grid;
    gap: var(--space-m);
    margin: 0;
  }

  @media (min-width: 40rem) {
    .skills__group {
      display: grid;
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: var(--space-m);
      align-items: baseline;
    }
  }

  .skills__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent);
  }

  .skills__items {
    margin: var(--space-2xs) 0 0;
  }

  @media (min-width: 40rem) {
    .skills__items {
      margin-top: 0;
    }
  }
</style>
