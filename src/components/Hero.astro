---
/**
 * Landing hero: name, tagline, CTAs, and a decorative terminal panel whose
 * contents are generated from real data rather than hard-coded.
 */
import { site, socialLinks } from '~/lib/site';
import { url } from '~/lib/url';
import { getExperience, getSkills } from '~/lib/content';
import Icon from './Icon.astro';

const [experience, skills] = await Promise.all([getExperience(), getSkills()]);
const current = experience[0];

// A short "stack" line for the terminal panel, taken from the first two skill
// groups so it stays true to skills.yaml.
const stack = skills
  .slice(0, 2)
  .flatMap((group) => group.data.items.slice(0, 3))
  .join(', ');

const firstName = site.name.split(' ')[0] ?? site.name;

// Glitch flavour for the name. `true` quantises the torn bands into pixel
// blocks; `false` leaves them as clean RGB-split slices. Flip and compare.
const pixelGlitch = true;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow" data-reveal>
        <span class="hero__status" aria-hidden="true"></span>
        {current ? `${current.data.role} · ${current.data.company}` : site.role}
      </p>

      {
        /* `data-text` feeds the glitch copies drawn in ::before/::after;
          `aria-label` pins the accessible name so screen readers that announce
          generated content do not read it three times over. */
      }
      <h1
        class={`hero__title${pixelGlitch ? ' hero__title--pixel' : ''}`}
        id="hero-title"
        data-text={site.name}
        aria-label={site.name}
        data-reveal
        data-reveal-delay="60"
      >
        {site.name}
      </h1>

      <p class="hero__role" data-reveal data-reveal-delay="110">{site.role}</p>

      <p class="hero__tagline" data-reveal data-reveal-delay="160">
        <span class="hero__prompt" aria-hidden="true">$</span>
        {site.tagline}
      </p>

      <div class="hero__actions" data-reveal data-reveal-delay="220">
        {
          site.cta.map((action) => (
            <a
              href={url(action.href)}
              class={`btn${action.primary ? ' btn--primary' : ''}`}
            >
              {action.label}
              <Icon name="arrow-right" size={16} />
            </a>
          ))
        }
        {
          site.resume && (
            <a href={url(site.resume.href)} class="btn">
              {site.resume.label}
            </a>
          )
        }
      </div>

      <ul
        class="hero__social"
        aria-label="Social links"
        data-reveal
        data-reveal-delay="280"
      >
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hero__social-link"
                rel={link.external ? 'me noopener' : undefined}
                target={link.external ? '_blank' : undefined}
              >
                <Icon name={link.key} size={20} label={link.label} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      /* Decorative terminal panel. Hidden from assistive tech: every fact in it
        already appears as real text elsewhere on the page. */
    }
    <div class="hero__terminal" aria-hidden="true" data-reveal data-reveal-delay="120">
      <div class="terminal">
        <div class="terminal__bar">
          <span class="terminal__dot terminal__dot--1"></span>
          <span class="terminal__dot terminal__dot--2"></span>
          <span class="terminal__dot terminal__dot--3"></span>
          <span class="terminal__title">{firstName.toLowerCase()}@portfolio — zsh</span>
        </div>
        <pre
          class="terminal__body"><code><span class="t-prompt">~ $</span> whoami
<span class="t-out">{site.name.toLowerCase()}</span>

<span class="t-prompt">~ $</span> cat role.txt
<span class="t-out">{current ? `${current.data.role} @ ${current.data.company}` : site.role}</span>

<span class="t-prompt">~ $</span> ls ./stack
<span class="t-out">{stack}</span>

<span class="t-prompt">~ $</span> ./now --status
<span class="t-ok">● shipping ML systems &amp; writing about it</span>

<span class="t-prompt">~ $</span> <span class="t-cursor" /></code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Light bottom padding — the About section supplies its own generous top
       padding, and doubling them opens a dead band under the hero. */
    padding-block: clamp(2.5rem, 1rem + 8vw, 6rem) var(--space-m);
    overflow: hidden;
  }

  /* Two soft neon washes behind the hero — the only large colour on the page.
     They live on separate pseudo-elements so each corner can flicker on its
     own clock; one layer would force them to twitch in lockstep. */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    inset: -30% -10% auto;
    height: 120%;
    z-index: -1;
    pointer-events: none;
  }

  .hero::before {
    --wash: var(--accent);
    --wash-strength: 17%;
    background: radial-gradient(
      40rem 22rem at 12% 8%,
      color-mix(in srgb, var(--wash) var(--wash-strength), transparent),
      transparent 70%
    );
  }

  .hero::after {
    --wash: var(--accent-2);
    --wash-strength: 15%;
    background: radial-gradient(
      34rem 20rem at 88% 22%,
      color-mix(in srgb, var(--wash) var(--wash-strength), transparent),
      transparent 70%
    );
  }

  /* The warm light theme keeps exactly one wash: amber, top-left, as a soft
     focal point. Neon over beige does not work — 17% teal composites to a cool
     sage grey, and the magenta corner to a pink that reads as a stain on paper
     rather than as light. So the cyan corner turns amber and the magenta one
     is dropped outright. Dark mode keeps both, untouched. */
  :global(:root[data-theme='light']) .hero::before {
    --wash: var(--accent-3);
    --wash-strength: 13%;
  }

  :global(:root[data-theme='light']) .hero::after {
    display: none;
  }

  /* Dark mode only: the washes stutter like a failing neon tube. Only opacity
     animates, so the hues above are untouched. Light mode is deliberately
     excluded — its glows are near-invisible already, and a flicker on a pale
     background reads as a rendering bug rather than an effect.

     `steps(1, end)` is what sells it: each keyframe segment holds its value
     instead of cross-fading, so the dips snap on and off electrically. */
  @keyframes glow-twitch {
    0%,
    38% {
      opacity: 1;
    }
    39% {
      opacity: 0.45;
    }
    40% {
      opacity: 1;
    }
    41.5% {
      opacity: 0.6;
    }
    42.5% {
      opacity: 1;
    }
    /* Long calm stretch, then a second, messier burst. */
    73% {
      opacity: 1;
    }
    73.8% {
      opacity: 0.3;
    }
    74.6% {
      opacity: 0.85;
    }
    75.4% {
      opacity: 0.5;
    }
    76.4%,
    100% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Mismatched durations plus a negative delay keep the two corners from
       ever settling into a visible pattern together. */
    :global(:root[data-theme='dark']) .hero::before {
      animation: glow-twitch 9s steps(1, end) infinite;
    }

    :global(:root[data-theme='dark']) .hero::after {
      animation: glow-twitch 13s steps(1, end) -4s infinite;
    }
  }

  .hero__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-2xl);
    }
  }

  /* -- Text column --------------------------------------------------------- */
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin: 0 0 var(--space-m);
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .hero__status {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
    flex: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__status {
      animation: pulse 2.4s var(--ease) infinite;
    }
  }

  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 0%, transparent);
    }
  }

  .hero__title {
    position: relative;
    margin: 0;
    font-size: var(--step-5);
    letter-spacing: -0.045em;
    background: linear-gradient(
      100deg,
      var(--text) 20%,
      var(--accent) 55%,
      var(--accent-2) 88%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Light theme drops the gradient entirely. It terminates in --accent-2, and
     magenta over beige is the same stain that came out of the corner washes,
     the About photo and the Contact card — leaving it in the largest text on
     the page would be the one place the decision was not followed through.
     Solid walnut instead, the same ink as the section headings. */
  :global(:root[data-theme='light']) .hero__title {
    background: none;
    -webkit-background-clip: border-box;
    background-clip: border-box;
    color: var(--heading);
  }

  /* Dark mode only: an RGB-split glitch on the name. Two flat-colour copies of
     the text sit exactly on top of the real h1; bursts tear horizontal bands
     out of them and shove those bands sideways, then snap back. The h1 itself
     never moves and keeps its gradient fill, so the name stays readable the
     whole time — the glitch reads as interference over it, not as the name
     falling apart. Light mode is left alone: cyan/magenta fringing on a pale
     background looks like a broken font, not a CRT. */
  :global(:root[data-theme='dark']) .hero__title::before,
  :global(:root[data-theme='dark']) .hero__title::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* The h1 clips its background to the glyphs and paints the text
       transparent. These copies want the opposite: no clipping, flat colour. */
    background: none;
    -webkit-background-clip: border-box;
    background-clip: border-box;
    opacity: 0.85;
    /* Fully clipped away. Each burst opens bands out of this resting state,
       which is why no opacity animation is needed. */
    clip-path: inset(0 0 100% 0);
  }

  :global(:root[data-theme='dark']) .hero__title::before {
    color: var(--accent);
  }

  :global(:root[data-theme='dark']) .hero__title::after {
    color: var(--accent-2);
  }

  /* -- Pixel variant -------------------------------------------------------
     Quantises the torn bands into a square grid, so a burst reads as the name
     dropping to a low-res framebuffer for a few frames. Only the copies are
     masked — the h1 underneath keeps its smooth gradient — so the typography
     is never permanently altered, which is what made a pixel font or a
     full-time SVG filter the wrong trade here.

     Two hard-stop repeating gradients (one per axis) intersected: the vertical
     stripes and horizontal stripes overlap only at the cells, leaving a lattice
     of solid squares. `--px-ink` under `--px-cell` is what leaves the dark
     gutter between them; set them equal for solid blocks with no grid showing.

     The mask sits in the element's own box, so it travels with the band when
     the burst shoves it sideways — the block moves as a unit rather than the
     text sliding under a fixed screen. */
  :global(:root[data-theme='dark']) .hero__title--pixel::before,
  :global(:root[data-theme='dark']) .hero__title--pixel::after {
    /* em-relative, so the grid scales with the fluid --step-5 headline
       instead of going coarse on mobile and fine on desktop. */
    --px-cell: 0.1em;
    --px-ink: 0.072em;

    -webkit-mask-image:
      repeating-linear-gradient(
        to right,
        #000 0 var(--px-ink),
        transparent var(--px-ink) var(--px-cell)
      ),
      repeating-linear-gradient(
        to bottom,
        #000 0 var(--px-ink),
        transparent var(--px-ink) var(--px-cell)
      );
    mask-image:
      repeating-linear-gradient(
        to right,
        #000 0 var(--px-ink),
        transparent var(--px-ink) var(--px-cell)
      ),
      repeating-linear-gradient(
        to bottom,
        #000 0 var(--px-ink),
        transparent var(--px-ink) var(--px-cell)
      );
    /* Safari spells the intersection `source-in`; everyone else `intersect`.
       Without this the two gradients union into a grid of holes instead. */
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    /* The lattice drops ~40% of each glyph, so lift the fill to compensate. */
    opacity: 1;
  }

  /* Both copies run on the same 7s clock so their bursts land together — that
     simultaneity is what makes the offset colours read as one glitch event
     rather than two unrelated flickers. Only the band positions and the
     direction of the shove differ between them. */
  @keyframes glitch-cyan {
    0%,
    40% {
      clip-path: inset(0 0 100% 0);
      transform: translate3d(0, 0, 0);
    }
    40.4% {
      clip-path: inset(14% 0 62% 0);
      transform: translate3d(-0.05em, 0.01em, 0);
    }
    41.2% {
      clip-path: inset(52% 0 30% 0);
      transform: translate3d(0.04em, -0.01em, 0);
    }
    42% {
      clip-path: inset(76% 0 6% 0);
      transform: translate3d(-0.02em, 0, 0);
    }
    42.8%,
    88% {
      clip-path: inset(0 0 100% 0);
      transform: translate3d(0, 0, 0);
    }
    88.6% {
      clip-path: inset(30% 0 48% 0);
      transform: translate3d(0.06em, 0, 0);
    }
    89.4% {
      clip-path: inset(8% 0 74% 0);
      transform: translate3d(-0.04em, 0.01em, 0);
    }
    90.2%,
    100% {
      clip-path: inset(0 0 100% 0);
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes glitch-magenta {
    0%,
    40% {
      clip-path: inset(0 0 100% 0);
      transform: translate3d(0, 0, 0);
    }
    40.4% {
      clip-path: inset(20% 0 54% 0);
      transform: translate3d(0.05em, -0.01em, 0);
    }
    41.2% {
      clip-path: inset(44% 0 40% 0);
      transform: translate3d(-0.05em, 0.01em, 0);
    }
    42% {
      clip-path: inset(68% 0 14% 0);
      transform: translate3d(0.03em, 0, 0);
    }
    42.8%,
    88% {
      clip-path: inset(0 0 100% 0);
      transform: translate3d(0, 0, 0);
    }
    88.6% {
      clip-path: inset(36% 0 40% 0);
      transform: translate3d(-0.06em, 0, 0);
    }
    89.4% {
      clip-path: inset(2% 0 80% 0);
      transform: translate3d(0.04em, -0.01em, 0);
    }
    90.2%,
    100% {
      clip-path: inset(0 0 100% 0);
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:root[data-theme='dark']) .hero__title::before {
      animation: glitch-cyan 7s steps(1, end) infinite;
    }

    :global(:root[data-theme='dark']) .hero__title::after {
      animation: glitch-magenta 7s steps(1, end) infinite;
    }
  }

  .hero__role {
    margin: var(--space-2xs) 0 var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: -0.01em;
  }

  .hero__tagline {
    position: relative;
    max-width: 52ch;
    margin: 0 0 var(--space-l);
    padding-left: 1.6rem;
    color: var(--text);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .hero__prompt {
    position: absolute;
    left: 0;
    top: 0.05em;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-3);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-bottom: var(--space-l);
  }

  .hero__social {
    display: flex;
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__social-link {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-m);
    color: var(--text-faint);
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .hero__social-link:hover {
    color: var(--accent);
    background: var(--surface-hover);
  }

  /* -- Terminal panel ------------------------------------------------------ */
  .hero__terminal {
    display: none;
  }

  @media (min-width: 62rem) {
    .hero__terminal {
      display: block;
    }
  }

  .terminal {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-l);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow:
      var(--shadow-card),
      0 0 60px -30px color-mix(in srgb, var(--accent) 60%, transparent);
    overflow: hidden;
    backdrop-filter: blur(6px);
  }

  .terminal__bar {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: 0.6rem var(--space-s);
    border-bottom: 1px solid var(--border);
    background: var(--bg-elev);
  }

  .terminal__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex: none;
  }

  .terminal__dot--1 {
    background: var(--neon-magenta);
  }
  .terminal__dot--2 {
    background: var(--neon-amber);
  }
  .terminal__dot--3 {
    background: var(--neon-cyan);
  }

  .terminal__title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .terminal__body {
    margin: 0;
    padding: var(--space-m);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.75;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--text-muted);
  }

  .t-prompt {
    color: var(--accent);
  }
  .t-out {
    color: var(--text);
  }
  .t-ok {
    color: var(--accent-3);
  }

  .t-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    background: var(--accent-2);
    translate: 0 0.15em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .t-cursor {
      animation: blink 1.15s steps(2, jump-none) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
